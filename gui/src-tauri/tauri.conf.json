{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp Studio",
  "version": "0.1.0",
  "identifier": "dev.ytdlp.studio",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yt-dlp Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A native desktop shell for yt-dlp",
    "longDescription": "yt-dlp Studio gives yt-dlp a polished native desktop interface while keeping the downloader core unchanged."
  }
}
